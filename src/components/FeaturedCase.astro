---
/**
 * The headline proof under the hero: the video where a client confirms his
 * result on a call, next to the number and the story. Content: `featured`
 * in src/data/site.ts.
 */
import VideoFrame from "./VideoFrame.astro";
import Icon from "./Icon.astro";
import { featured as f, site } from "../data/site";

const vertical = f.video.ratio === "9 / 16";
const who = [f.client.business, [f.client.trade, f.client.city].filter(Boolean).join(" · ")].filter(Boolean).join(", ");
---

<section class="section fc" id="proof" aria-labelledby="proof-h">
  <div class:list={["wrap fc__in", vertical ? "fc__in--tall" : "fc__in--wide"]}>
    <div class="fc__media" data-reveal>
      <div class="fc__frame">
        <VideoFrame playbackId={f.video.playbackId} title={`Client call: $80K+ in jobs two weeks after launching ads`} posterTime={f.video.posterTime} ratio={f.video.ratio} label="Watch the call" sizes={vertical ? "(min-width: 900px) 400px, 90vw" : "(min-width: 1280px) 1240px, 100vw"} />
      </div>
      <p class="fc__badge"><span class="fc__dot" aria-hidden="true"></span>We call him live. He confirms it.</p>
    </div>

    <div class="fc__body">
      <p class="eyebrow" data-reveal>Real client · Real call</p>
      <h2 id="proof-h" class="fc__hook" data-reveal>“{f.hook}”</h2>

      <div class="fc__result" data-reveal>
        <p class="fc__num display">{f.result.prefix}<span data-count={f.result.value}>{f.result.value}</span>{f.result.suffix}</p>
        <div>
          <p class="fc__label">{f.result.label}</p>
          <p class="muted">{f.timeframe}</p>
        </div>
      </div>

      <div class="fc__concern" data-reveal>
        <p class="fc__tag">The concern</p>
        <p class="fc__concern-text">{f.concern}</p>
      </div>

      <div class="fc__story" data-reveal>{f.story.map((p) => <p>{p}</p>)}</div>

      {f.quote && (
        <blockquote class="fc__quote" data-reveal>
          <p>“{f.quote}”</p>
          {f.client.name && <footer><strong>{f.client.name}</strong>{who && <span class="muted">{who}</span>}</footer>}
        </blockquote>
      )}

      <div class="fc__cta" data-reveal>
        <a class="btn" href={site.bookingUrl}>Get a plan like his <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .fc { position: relative; overflow: hidden; }
  .fc::before { content: ""; position: absolute; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px; left: -20vw; top: 10%; border-radius: 50%; background: radial-gradient(closest-side, var(--brand-soft), transparent); pointer-events: none; }
  .fc__in { position: relative; display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .fc__in--tall { grid-template-columns: minmax(0, 400px) minmax(0, 1fr); }
  .fc__in--wide { grid-template-columns: 1fr; }
  @media (max-width: 860px) { .fc__in--tall { grid-template-columns: 1fr; } .fc__in--tall .fc__media { max-width: 300px; margin-top: 1rem; width: 100%; margin-inline: auto; } }

  .fc__media { position: relative; }
  .fc__frame { padding: 10px; border-radius: 34px; background: var(--ink); box-shadow: 0 50px 100px -40px rgb(59 0 252 / 0.55), 0 0 0 1px var(--line); transform: rotate(-2deg); transition: transform 0.8s var(--ease); }
  .fc__in--wide .fc__frame { transform: none; border-radius: calc(var(--radius-lg) + 10px); }
  .fc__media:hover .fc__frame { transform: rotate(0deg) translateY(-4px); }
  .fc__frame :global(.vf) { border-radius: 26px; }
  .fc__badge {
    position: absolute; right: -1.25rem; top: 2.5rem; display: flex; align-items: center; gap: 0.6rem;
    padding: 0.75rem 1.1rem; border-radius: 999px; background: #fff; color: var(--ink); font-weight: 650; font-size: 0.92rem;
    box-shadow: 0 20px 40px -16px rgb(7 5 26 / 0.35); animation: float 5s ease-in-out infinite;
  }
  @media (max-width: 860px) { .fc__badge { right: 50%; transform: translateX(50%); top: -1.1rem; white-space: nowrap; animation: none; } }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .fc__dot { width: 9px; height: 9px; border-radius: 50%; background: #18c964; box-shadow: 0 0 0 0 rgb(24 201 100 / 0.6); animation: live 1.8s infinite; }
  @keyframes live { 70%, 100% { box-shadow: 0 0 0 9px rgb(24 201 100 / 0); } }

  .fc__hook { margin-top: 1.25rem; font-family: var(--font-body); font-size: clamp(1.5rem, 2.8vw, 2.25rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.025em; }
  .fc__result { display: flex; align-items: center; gap: 1.25rem 1.75rem; flex-wrap: wrap; margin-top: 2.25rem; padding-block: 1.75rem; border-block: 1px solid var(--line); }
  .fc__num { font-size: clamp(4rem, 10vw, 7.5rem); line-height: 0.85; color: var(--brand); }
  .fc__label { font-size: 1.25rem; font-weight: 700; }
  .fc__concern { margin-top: 2rem; padding: 1.25rem 1.5rem; border-left: 3px solid var(--brand); background: var(--paper-2); border-radius: 0 var(--radius) var(--radius) 0; }
  .fc__tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .fc__concern-text { margin-top: 0.35rem; font-size: 1.15rem; font-weight: 650; }
  .fc__story { display: grid; gap: 0.9rem; margin-top: 1.75rem; color: var(--muted); font-size: 1.075rem; }
  .fc__quote { margin: 1.75rem 0 0; }
  .fc__quote p { font-size: 1.2rem; font-style: italic; }
  .fc__quote footer { display: flex; flex-direction: column; margin-top: 0.6rem; font-size: 0.95rem; }
  .fc__cta { margin-top: 2.25rem; }
</style>

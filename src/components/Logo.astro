---
/**
 * The Amplify Digital Group logo: blue AMPLIFY over white DIGITAL GROUP,
 * so it's made for dark backgrounds. Source file: public/brand/logo-640.webp.
 * `dark` uses the version with dark DIGITAL GROUP text, for white backgrounds.
 */
interface Props { class?: string; height?: number; eager?: boolean; dark?: boolean }
const { class: cls, height = 40, eager = false, dark = false } = Astro.props;
const file = dark ? "logo-dark" : "logo";
const width = Math.round((height * 2000) / 593);
---
<img
  class:list={["logo", cls]}
  src={`/brand/${file}-320.webp`}
  srcset={`/brand/${file}-320.webp 320w, /brand/${file}-640.webp 640w`}
  sizes={`${width}px`}
  width={width}
  height={height}
  alt="Amplify Digital Group"
  loading={eager ? "eager" : "lazy"}
  decoding="async"
/>

<style>
  .logo { display: block; width: auto; }
</style>

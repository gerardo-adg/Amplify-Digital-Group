---
/**
 * Slowly scrolling row of the contractors we work with, on a dark band.
 * Logos show in greyscale (badge logos lose their lettering as pure white
 * silhouettes); clients without a logo file show their name in white. Stops moving for visitors who prefer reduced motion.
 */
import { clients } from "../../data/site";

// Repeat the list so one pass is wider than the screen, then render it
// twice so the loop is seamless.
const pass = Array.from({ length: Math.max(1, Math.ceil(8 / clients.length)) }, () => clients).flat();
---
<section class="cs" aria-label="Contractors we work with">
  <ul class="sr-only">{clients.map((c) => <li>{c.name}</li>)}</ul>
  <div class="cs__viewport" aria-hidden="true">
    <div class="cs__track">
      {[0, 1].map(() => pass.map((c) => (
        <div class="cs__item">
          {c.logo
            ? <img src={c.logo} alt="" width={c.width} height={c.height} style={[c.scale && `--s:${c.scale}`, c.boost && `--b:${c.boost}`].filter(Boolean).join(";") || undefined} loading="lazy" decoding="async" />
            : <span class="cs__name">{c.name}</span>}
        </div>
      )))}
    </div>
  </div>
</section>

<style>
  .cs { padding-block: 1.75rem; background: var(--ink); }
  .cs__viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .cs__track { display: flex; width: max-content; animation: csScroll 40s linear infinite; }
  .cs__item { flex: none; display: grid; place-items: center; height: 80px; padding-inline: clamp(1.75rem, 4vw, 3rem); }
  /* Greyscale, brightened so dark parts still read on the dark band */
  .cs__item img { height: calc(80px * var(--s, 1)); width: auto; filter: grayscale(1) contrast(1.35) brightness(calc(1.2 * var(--b, 1))); }
  .cs__name { font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-style: italic; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 0.01em; white-space: nowrap; color: #fff; opacity: 0.7; transition: opacity 0.3s; }
  .cs__item:hover .cs__name { opacity: 1; }
  @keyframes csScroll { to { transform: translateX(-50%); } }
  /* Phones: client logos stay a bit smaller than the 28px Amplify logo's visual weight */
  @media (max-width: 899px) {
    .cs { padding-block: 0.9rem; }
    .cs__item { height: 36px; padding-inline: 1.1rem; }
    .cs__item img { height: calc(36px * var(--s, 1)); }
    .cs__name { font-size: 0.78rem; }
    .cs__track { animation-duration: 26s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs__track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .cs__viewport { mask-image: none; -webkit-mask-image: none; }
  }
</style>

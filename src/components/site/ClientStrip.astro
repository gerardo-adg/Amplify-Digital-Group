---
/**
 * Slowly scrolling row of the contractors we work with. Logos show in
 * full color; clients without a logo file show their name. Stops moving for visitors who prefer reduced motion.
 */
import { clients } from "../../data/site";

// Repeat the list so one pass is wider than the screen, then render it
// twice so the loop is seamless.
const pass = Array.from({ length: Math.max(1, Math.ceil(8 / clients.length)) }, () => clients).flat();
---
<section class="cs" aria-label="Contractors we work with">
  <p class="cs__label">Trusted by contractors across Northern California</p>
  <ul class="sr-only">{clients.map((c) => <li>{c.name}</li>)}</ul>
  <div class="cs__viewport" aria-hidden="true">
    <div class="cs__track">
      {[0, 1].map(() => pass.map((c) => (
        <div class="cs__item">
          {c.logo
            ? <img src={c.logo} alt="" width={c.width} height={c.height} loading="lazy" decoding="async" />
            : <span class="cs__name">{c.name}</span>}
        </div>
      )))}
    </div>
  </div>
</section>

<style>
  .cs { padding-block: 2.25rem 2.5rem; background: var(--paper); border-bottom: 1px solid var(--line); }
  .cs__label { text-align: center; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 1.5rem; padding-inline: 1rem; }
  .cs__viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .cs__track { display: flex; width: max-content; animation: csScroll 40s linear infinite; }
  .cs__viewport:hover .cs__track { animation-play-state: paused; }
  .cs__item { flex: none; display: grid; place-items: center; height: 96px; padding-inline: clamp(1.75rem, 4vw, 3rem); }
  .cs__item img { height: 96px; width: auto; }
  .cs__name { font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-style: italic; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 0.01em; white-space: nowrap; color: var(--ink); opacity: 0.55; transition: opacity 0.4s; }
  .cs__item:hover .cs__name { opacity: 0.9; }
  @keyframes csScroll { to { transform: translateX(-50%); } }
  @media (max-width: 899px) {
    .cs { padding-block: 1.75rem 2rem; }
    .cs__item { height: 72px; }
    .cs__item img { height: 72px; }
    .cs__name { font-size: 1rem; }
    .cs__track { animation-duration: 30s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs__track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; }
    .cs__viewport { mask-image: none; -webkit-mask-image: none; }
  }
</style>

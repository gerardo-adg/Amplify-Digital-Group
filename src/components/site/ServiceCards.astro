---
import Icon from "../Icon.astro";
import { services, featured } from "../../data/site";
---
<ul class="svc" data-stagger>
  {services.map((s) => (
    <li style="display:contents">
      <a class:list={["svc__card", s.main && "svc__card--main"]} href={`/services/${s.slug}/`} data-reveal>
        <span class="svc__top"><span class="svc__icon"><Icon name={s.icon} size={26} /></span>{s.main && <span class="svc__badge">Main service</span>}</span>
        <h3>{s.title}</h3>
        <p class="muted">{s.body}</p>
        {s.main && (
          <span class="svc__proof"><strong class="display">$80K+</strong><span>booked by {featured.client.business} off $647 in ad spend, two weeks after launch</span></span>
        )}
        <ul class="svc__pts">{s.points.map((p) => <li>{p}</li>)}</ul>
        <span class="svc__more">Learn more <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>

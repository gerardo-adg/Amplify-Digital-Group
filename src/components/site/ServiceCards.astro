---
/**
 * The three services as equal cards (Meta ads in dark so it stands out).
 * Each card links to its service page. On phones the icon sits to the left.
 */
import Icon from "../Icon.astro";
import { services } from "../../data/site";
---
<ul class="svc" data-stagger>
  {services.map((s) => (
    <li style="display:contents">
      <a class:list={["svc__card", s.main && "svc__card--main"]} href={`/services/${s.slug}/`} data-reveal>
        <span class="svc__icon"><Icon name={s.icon} size={24} /></span>
        <h3>{s.title}</h3>
        <p class="muted">{s.short}</p>
        <span class="svc__more">Learn more <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>

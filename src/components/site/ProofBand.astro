---
/** Evaristo's numbers in one blue strip, linking to the full story. */
import Icon from "../Icon.astro";
import { featured as f } from "../../data/site";
interface Props { link?: boolean }
const { link = true } = Astro.props;
---
<section class="band" aria-label="Client result">
  <div class="wrap band__in">
    <div class="band__stats">
      {f.results.map((r) => (
        <div class="band__stat"><strong class="display">{r.prefix}{r.value}{r.suffix}</strong><span>{r.label}</span></div>
      ))}
      <div class="band__stat"><strong class="display">30 days</strong><span>after launch</span></div>
    </div>
    <div class="band__who">
      <p>{f.client.name}, {f.client.business}</p>
      <p>{f.client.city} · Meta ads</p>
      {link && <a href="/results/#evaristo">Watch him tell it <Icon name="arrow" size={16} /></a>}
    </div>
  </div>
</section>

---
/** A website we built, linking to the live site. */
import Icon from "../Icon.astro";
interface Props { client: string; place: string; url: string; body: string; tags: string[] }
const { client, place, url, body, tags } = Astro.props;
---
<article class="prj" data-reveal>
  <div class="prj__browser" aria-hidden="true"><span></span><span></span><span></span><p>{url.replace(/^https?:\/\//, "").replace(/\/$/, "")}</p></div>
  <div class="prj__body">
    <ul class="prj__tags">{tags.map((t) => <li>{t}</li>)}</ul>
    <h3>{client}</h3>
    <p class="muted prj__place">{place}</p>
    <p class="prj__text">{body}</p>
    <a class="btn btn--ghost prj__link" href={url} target="_blank" rel="noopener">Visit the site <Icon name="arrow" size={16} /></a>
  </div>
</article>

<style>
  .prj { max-width: 760px; margin-inline: auto; border-radius: var(--radius-lg); background: var(--paper); border: 1px solid var(--line); overflow: hidden; box-shadow: 0 30px 60px -40px rgb(7 5 26 / 0.35); }
  .prj__browser { display: flex; align-items: center; gap: 6px; padding: 0.8rem 1rem; background: var(--ink); }
  .prj__browser span { width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 255 / 0.25); }
  .prj__browser p { margin-left: 0.75rem; padding: 0.25rem 0.75rem; border-radius: 6px; background: rgb(255 255 255 / 0.08); color: var(--muted-dark); font-size: 0.82rem; }
  .prj__body { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .prj__tags { display: flex; gap: 0.4rem; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .prj__tags li { font-size: 0.78rem; font-weight: 650; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--brand-soft); color: var(--brand); }
  .prj h3 { margin-top: 1rem; font-size: clamp(1.5rem, 3vw, 2rem); font-family: var(--font-body); font-weight: 800; letter-spacing: -0.02em; }
  .prj__place { margin-top: 0.25rem; }
  .prj__text { margin-top: 1rem; font-size: 1.08rem; }
  .prj__link { margin-top: 1.5rem; color: var(--ink); }
  @media (max-width: 899px) { .prj__body { text-align: center; } .prj__tags { justify-content: center; } }
</style>

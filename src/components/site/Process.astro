---
/**
 * The process as a timeline: numbered circles on a line, ending in a
 * checkmark for the result. Runs down the left side on phones.
 */
import { steps } from "../../data/site";
---
<ol class="tl" data-stagger>
  {steps.map((s, i) => (
    <li class:list={["tl__step", s.done && "tl__step--done"]} data-reveal>
      <span class="tl__n" aria-hidden="true">{s.done ? "✓" : i + 1}</span>
      <h3>{s.title}</h3>
      <p class="muted">{s.body}</p>
    </li>
  ))}
</ol>

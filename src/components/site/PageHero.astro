---
/**
 * White hero at the top of every page, black text. (A background video can go here later.) `title` lines: the last one can be
 * underlined in the brand blue. Optional breadcrumb trail and buttons.
 */
interface Props {
  title: string[];
  callout?: string;
  // Small blue line above the headline (keywords for Google)
  eyebrow?: string;
  sub?: string;
  // Show the subheadline in bold dark text instead of grey
  subBold?: boolean;
  underlineLast?: boolean;
  wide?: boolean;
  crumbs?: { name: string; href: string }[];
}
const { title, callout, eyebrow, sub, subBold = false, underlineLast = false, wide = false, crumbs } = Astro.props;
---
<section class="ph">
  <div class="wrap ph__in">
    {crumbs && (
      <nav aria-label="Breadcrumb">
        <ol class="ph__crumbs">
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow ph__eyebrow" data-reveal>{eyebrow}</p>}
    {callout && <p class="ph__callout" data-reveal>{callout}</p>}
    <h1 class:list={["display ph__title", wide && "ph__title--wide"]} data-reveal="lines">
      {title.map((line, i) => <span class="l"><span class:list={["l__in", underlineLast && i === title.length - 1 && "ph__u"]}>{line}</span>{" "}</span>)}
    </h1>
    {sub && <p class:list={["ph__sub", subBold ? "ph__sub--bold" : "muted"]} data-reveal style="--i:2">{sub}</p>}
    {Astro.slots.has("default") && <div class="ph__ctas" data-reveal style="--i:3"><slot /></div>}
  </div>
</section>

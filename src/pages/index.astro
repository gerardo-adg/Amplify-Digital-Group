---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import VideoFrame from "../components/VideoFrame.astro";
import Footer from "../components/Footer.astro";
import FeaturedCase from "../components/FeaturedCase.astro";
import { site, hero, steps, objections, stories, faqs, featured, isSample } from "../data/site";

const title = `More booked jobs from Facebook & Instagram ads | ${site.name}`;
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title={title} description={site.description}>
  <Header />
  <main id="main">
    <!-- HERO -->
    <section class="hero dark" id="top">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="wrap hero__in">
        <h1 class="display hero__title" data-reveal="lines">
          {hero.title.map((line, i) => <span class="l"><span class:list={["l__in", i > 0 && "grad"]}>{line}</span>{" "}</span>)}
        </h1>
        <p class="hero__sub muted" data-reveal style="--i:1">{hero.subheadline}</p>
        <div class="hero__video" data-reveal style="--i:2">
          <VideoFrame playbackId={hero.vsl.playbackId} title={hero.vsl.title} posterTime={hero.vsl.posterTime} label="Watch the video" sizes="(min-width: 900px) 680px, 100vw" />
        </div>
        {hero.vsl.playbackId && <p class="hero__caption" data-reveal style="--i:3">{hero.vsl.caption}</p>}
        <div class="hero__cta" data-reveal style="--i:3">
          <a class="btn hero__btn" href={site.ctaUrl}>{hero.primaryCta} <Icon name="arrow" size={18} /></a>
          <p class="hero__note muted">{hero.ctaNote}</p>
        </div>
      </div>
    </section>

    <!-- OBJECTIONS: the three biggest, most common first -->
    <section class="obj" aria-label="Common concerns">
      <ul class="wrap obj__list" data-stagger>
        {objections.map((o) => (
          <li class="obj__item" data-reveal>
            <span class="obj__check" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
            <div>
              <p class="obj__q">{o.q}</p>
              <p class="obj__a muted">{o.a}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- PROOF -->
    <FeaturedCase />

    <!-- PROCESS -->
    <section class="section dark process" id="process" aria-labelledby="process-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow" data-reveal>How it works</p>
          <h2 id="process-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">We handle it</span></span><span class="l"><span class="l__in grad">start to finish.</span></span></h2>
          <p class="muted head__p" data-reveal>Your only job is to show up for the shoot. We do the rest.</p>
        </div>
        <ol class="steps" data-stagger>
          {steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__n display">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- CONCERNS -->
    <section class="section stories" aria-labelledby="stories-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow" data-reveal>Before they signed</p>
          <h2 id="stories-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">They had doubts</span></span><span class="l"><span class="l__in grad">too.</span></span></h2>
          <p class="muted head__p" data-reveal>Here's what worried our clients before they signed, and what happened next.</p>
        </div>
        <ul class="story-list" data-stagger>
          {stories.filter((s) => !isSample(s)).map((s) => (
            <li class:list={["story", s.video && "story--video"]} data-reveal>
              {s.video && (
                <div class="story__video">
                  <VideoFrame playbackId={s.video.playbackId} title={`${s.name || "Client"} on working with ${site.name}`} posterTime={s.video.posterTime} ratio={s.video.ratio ?? "9 / 16"} label="Watch" sizes="(min-width: 760px) 300px, 100vw" />
                  {s.when && <span class="story__when">{s.when}</span>}
                </div>
              )}
              {isSample(s) && <span class="tag story__tag">Sample</span>}
              <p class="story__label">The concern</p>
              <p class="story__concern display">{s.concern}</p>
              {s.concernQuote && <p class="story__concern-quote">“{s.concernQuote}”<span class="muted">{s.name || "Our client"}</span></p>}
              <p class="story__label story__label--ok">What happened</p>
              <p class="story__outcome">{s.outcome}</p>
              {(s.quote || s.name) && (
                <blockquote class="story__quote">
                  {s.quote && <p>“{s.quote}”</p>}
                  {s.name && <footer><strong>{s.name}</strong>{s.business && <span class="muted">{s.business}</span>}</footer>}
                </blockquote>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <div class="head faq__head">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 id="faq-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">Straight</span></span><span class="l"><span class="l__in grad">answers.</span></span></h2>
          <p class="muted head__p" data-reveal>Something not covered here? Ask us on the call. That's what it's for.</p>
        </div>
        <div class="faq__list" data-stagger>
          {faqs.map((f, i) => (
            <details class="qa" data-reveal open={i === 0}>
              <summary><span>{f.q}</span><span class="qa__icon" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
              <div class="qa__a"><p class="muted">{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta dark" id="book" aria-labelledby="cta-h">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="wrap cta__in">
        <h2 id="cta-h" class="display cta__title" data-reveal="lines"><span class="l"><span class="l__in">Ready to get</span></span><span class="l"><span class="l__in grad">amplified?</span></span></h2>
        <p class="muted cta__p" data-reveal>{hero.ctaNote}</p>
        <div class="cta__ctas" data-reveal>
          <a class="btn" href={site.ctaUrl}>{hero.primaryCta} <Icon name="arrow" size={18} /></a>
          {site.phone.tel ? <a class="btn btn--ghost" href={`tel:${site.phone.tel}`}>{site.phone.display}</a> : <a class="btn btn--ghost" href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .grad { background: linear-gradient(90deg, var(--brand-hi), #a98bff 60%, #fff); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.08em; }
  :not(.dark) > .wrap .grad, .section:not(.dark) .grad { background-image: linear-gradient(90deg, var(--brand), var(--brand-hi)); }

  /* Hero */
  .hero { position: relative; padding-top: clamp(8rem, 18vw, 12rem); padding-bottom: clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .hero__glow { position: absolute; inset: 0; pointer-events: none; }
  .hero__glow span { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.75; animation: drift 18s ease-in-out infinite alternate; }
  .hero__glow span:first-child { width: 60vw; height: 60vw; max-width: 820px; max-height: 820px; left: -18vw; top: max(6vw, 90px); background: radial-gradient(closest-side, var(--brand), transparent); }
  .hero__glow span:last-child { width: 45vw; height: 45vw; max-width: 620px; max-height: 620px; right: -12vw; top: 10%; background: radial-gradient(closest-side, #7a2bff, transparent); animation-duration: 22s; animation-delay: -6s; }
  @keyframes drift { to { transform: translate3d(8vw, 6vw, 0) scale(1.15); } }
  .hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--line-dark) 1px, transparent 1px), linear-gradient(90deg, var(--line-dark) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 20%, transparent 75%); opacity: 0.5; }
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "sub" "video" "caption" "cta";
    align-items: start;
  }
  .hero__title { grid-area: title; font-size: clamp(2.1rem, 4.4vw, 4rem); }
  .hero__sub { grid-area: sub; margin-top: 1rem; font-size: clamp(1.05rem, 1.5vw, 1.2rem); max-width: 34rem; }
  .hero__video { grid-area: video; margin-top: 1.75rem; }
  .hero__video :global(.vf) { box-shadow: 0 40px 120px -30px rgb(59 0 252 / 0.65), 0 0 0 1px var(--line-dark); }
  .hero__caption { grid-area: caption; margin-top: 1rem; font-size: 1.05rem; font-weight: 600; }
  .hero__cta { grid-area: cta; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; margin-top: 1.5rem; }
  .hero__btn { padding: 1.1rem 1.75rem; font-size: 1.05rem; }
  .hero__note { flex-basis: 100%; max-width: 30rem; font-size: 0.92rem; }
  @media (max-width: 899px) {
    .hero { padding-top: 5.75rem; }
    .hero__title { font-size: clamp(1.75rem, 8.4vw, 2.6rem); }
    .hero__sub { margin-top: 0.75rem; font-size: 1rem; }
    .hero__video { margin-top: 1.25rem; }
    .hero__cta { margin-top: 1.25rem; }
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      grid-template-rows: 1fr auto auto auto auto 1fr;
      grid-template-areas: ". video" "title video" "sub video" "caption video" "cta video" ". video";
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .hero__video { margin-top: 0; align-self: center; }
    .hero__title { font-size: clamp(2rem, 3.05vw, 2.85rem); }
    .hero__title .l { white-space: nowrap; }
    .hero__cta { margin-top: 2rem; }
    .hero__caption { margin-top: 1.5rem; }
  }

  /* Section heads */
  .head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .head--row { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; }
  .head--row .head__p { max-width: 24rem; }
  .h2 { font-size: clamp(2.1rem, 6vw, 4.6rem); margin-top: 1.1rem; }
  .head__p { margin-top: 1.4rem; font-size: 1.125rem; }

  /* Objections */
  .obj { background: var(--paper); border-bottom: 1px solid var(--line); }
  .obj__list { list-style: none; margin-block: 0; padding: clamp(2.5rem, 5vw, 3.5rem) 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .obj__item { display: flex; gap: 0.9rem; align-items: flex-start; }
  .obj__check { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand); color: #fff; margin-top: 0.1rem; }
  .obj__q { font-weight: 750; font-size: 1.08rem; letter-spacing: -0.01em; }
  .obj__a { margin-top: 0.35rem; font-size: 0.98rem; }
  @media (max-width: 899px) { .obj__list { grid-template-columns: 1fr; } }

  /* Process */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; counter-reset: s; }
  .step { position: relative; padding: 2rem 1.75rem 2rem 0; border-top: 1px solid var(--line-dark); }
  .step::before { content: ""; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--brand-hi); transition: width 1.2s var(--ease) calc(var(--i, 0) * 200ms + 300ms); }
  .step.is-in::before { width: 100%; }
  .step__n { display: block; font-size: clamp(2.6rem, 5vw, 3.6rem); color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.35); margin-bottom: 1.5rem; }
  .step h3 { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.01em; }
  .step p { margin-top: 0.7rem; }

  /* Stories */
  .stories { background: var(--paper-2); }
  .story-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .story-list > .story { flex: 1 1 290px; }
  .story-list > .story--video { flex-basis: 100%; }
  .story { position: relative; display: flex; flex-direction: column; padding: 2rem 1.75rem; border-radius: var(--radius-lg); background: var(--paper); border: 1px solid var(--line); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .story:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgb(7 5 26 / 0.3); }
  .story__tag { position: absolute; top: 1.25rem; right: 1.25rem; }
  .story--video { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); grid-template-rows: auto auto auto auto 1fr; column-gap: clamp(1.5rem, 4vw, 3.5rem); padding: 1rem clamp(1.5rem, 3vw, 2.5rem) 1rem 1rem; }
  .story--video > :not(.story__video) { grid-column: 2; }
  .story--video > .story__label:first-of-type { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .story--video .story__concern { font-size: clamp(1.4rem, 2.6vw, 2rem); }
  .story--video .story__outcome { font-size: 1.1rem; max-width: 36rem; }
  .story__video { position: relative; grid-column: 1; grid-row: 1 / -1; align-self: start; }
  @media (max-width: 760px) {
    .story--video { display: flex; padding: 0.75rem 0.75rem 1.75rem; }
    .story--video > :not(.story__video) { margin-inline: 1rem; }
    .story__video { align-self: stretch; margin-bottom: 1.5rem; }
    .story__video :global(.vf) { aspect-ratio: 4 / 5 !important; }
  }
  .story__video :global(.vf) { border-radius: calc(var(--radius-lg) - 8px); }
  .story__when { position: absolute; top: 1rem; left: 1rem; padding: 0.35rem 0.75rem; border-radius: 999px; background: #fff; color: var(--ink); font-size: 0.8rem; font-weight: 700; }
  .story__label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .story__label--ok { color: var(--brand); margin-top: 1.75rem; }
  .story__concern { font-size: 1.35rem; line-height: 1.15; margin-top: 0.6rem; text-transform: none; }
  .story__outcome { margin-top: 0.6rem; }
  .story__concern-quote { margin-top: 0.75rem; font-style: italic; }
  .story__concern-quote span { display: block; margin-top: 0.2rem; font-style: normal; font-size: 0.88rem; }
  .story__quote { margin: auto 0 0; padding-top: 1.5rem; margin-top: 1.75rem; border-top: 1px solid var(--line); }
  .story__quote p { font-style: italic; }
  .story__quote footer { display: flex; flex-direction: column; margin-top: 0.9rem; font-size: 0.92rem; }

  /* FAQ */
  .faq__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq__head { position: sticky; top: 110px; margin-bottom: 0; }
  .faq__head .h2 { font-size: clamp(2.1rem, 4.6vw, 3.9rem); }
  @media (max-width: 860px) { .faq__in { grid-template-columns: 1fr; } .faq__head { position: static; } }
  .qa { border-bottom: 1px solid var(--line); }
  .qa:first-child { border-top: 1px solid var(--line); }
  .qa summary { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.5rem 0; cursor: pointer; list-style: none; font-size: clamp(1.05rem, 1.8vw, 1.25rem); font-weight: 650; letter-spacing: -0.01em; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa__icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: var(--paper-2); color: var(--brand); transition: transform 0.5s var(--ease), background 0.3s, color 0.3s; }
  .qa summary:hover .qa__icon { background: var(--brand-soft); }
  .qa[open] .qa__icon { transform: rotate(45deg); background: var(--brand); color: #fff; }
  .qa__a { padding: 0 3.5rem 1.6rem 0; }
  .qa[open] .qa__a { animation: open 0.6s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-8px); } }

  /* CTA */
  .cta { position: relative; overflow: hidden; padding-block: clamp(6rem, 14vw, 11rem); text-align: center; }
  .cta__in { position: relative; }
  .cta__title { font-size: clamp(2.6rem, 9vw, 7.5rem); }
  .cta__p { max-width: 34rem; margin: 1.75rem auto 0; font-size: 1.15rem; }
  .cta__ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; justify-content: center; }

  /* ---- Phones and small tablets: everything centered ---- */
  @media (max-width: 899px) {
    main { text-align: center; }
    .head, .head__p { margin-inline: auto; }
    .head--row { flex-direction: column; align-items: center; }
    .hero__cta { flex-direction: column; justify-content: center; }
    .hero__sub, .hero__note { margin-inline: auto; }
    /* Let the headline flow as one sentence on narrow screens instead of forced lines */
    .hero__title { text-wrap: balance; }
    .hero__title .l, .hero__title .l__in { display: inline; }
    .obj__item { flex-direction: column; align-items: center; text-align: center; }
    .step { padding-right: 0; }
    .story--video { text-align: center; }
    .story__outcome { margin-inline: auto; }
    .story__quote footer { align-items: center; }
    .qa summary { text-align: center; }
    .qa summary > span:first-child { flex: 1; }
    .qa summary::before { content: ""; flex: none; width: 40px; }
    .qa__a { padding: 0 0 1.6rem; }
  }
</style>

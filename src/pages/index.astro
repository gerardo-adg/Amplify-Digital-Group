---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import VideoFrame from "../components/VideoFrame.astro";
import FeaturedCase from "../components/FeaturedCase.astro";
import { site, hero, services, steps, stats, work, stories, faqs, featured, isSample } from "../data/site";

const title = `${site.name} | Meta ads, content and websites for service businesses`;
const ticker = ["Meta ads", "Facebook ads", "Instagram ads", "Ad creative", "Video content", "Reels", "Websites", "Lead generation"];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title={title} description={site.description}>
  <Header />
  <main id="main">
    <!-- HERO -->
    <section class="hero dark" id="top">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="wrap hero__in">
        <h1 class="display hero__title" data-reveal="lines">
          {hero.title.map((line, i) => <span class="l"><span class:list={["l__in", i === hero.title.length - 1 && "grad"]}>{line}</span></span>)}
        </h1>
        <div class="hero__video" data-reveal style="--i:2">
          <VideoFrame playbackId={hero.vsl.playbackId} title={hero.vsl.title} posterTime={hero.vsl.posterTime} label="Watch the video" sizes="(min-width: 900px) 680px, 100vw" />
        </div>
        {hero.vsl.playbackId && <p class="hero__caption" data-reveal style="--i:3">{hero.vsl.caption}</p>}
        <div class="hero__cta" data-reveal style="--i:3">
          <a class="btn hero__btn" href={site.ctaUrl}>{hero.primaryCta} <Icon name="arrow" size={18} /></a>
          <p class="hero__note muted">{hero.ctaNote}</p>
        </div>
        <a class="hero__proof" href="#proof" data-reveal style="--i:4" aria-label={`${hero.proof.map((p) => `${p.value} ${p.label}`).join(", ")}. Read Evaristo's story.`}>
          {hero.proof.map((p) => (
            <span class="hero__stat"><strong class="display">{p.value}</strong><span>{p.label}</span></span>
          ))}
          <span class="hero__who">{featured.client.business}, {featured.client.city} <Icon name="arrow" size={15} /></span>
        </a>
      </div>
    </section>

    <!-- TICKER -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => ticker.map((t) => <span class="display">{t}<i>✦</i></span>))}
      </div>
    </div>

    <!-- PROOF -->
    <FeaturedCase />

    <!-- SERVICES -->
    <section class="section svc-sec" id="services" aria-labelledby="services-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow" data-reveal>What we do</p>
          <h2 id="services-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">One team for</span></span><span class="l"><span class="l__in">everything that</span></span><span class="l"><span class="l__in grad">brings in work.</span></span></h2>
          <p class="muted head__p" data-reveal>Meta ads bring the customers in. Our content makes them stop scrolling. Your website turns them into booked jobs. We do all three, so it all points the same way.</p>
        </div>
        <ul class="svc" data-stagger>
          {services.map((s, i) => (
            <li class:list={["svc__card", s.main && "svc__card--main"]} data-reveal>
              <div class="svc__top"><span class="svc__icon"><Icon name={s.icon} size={26} /></span>{s.main ? <span class="svc__badge">Main service</span> : <span class="svc__n">{pad(i + 1)}</span>}</div>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
              {s.main && (
                <a class="svc__proof" href="#proof">
                  <span class="svc__proof-n display">$80K+</span>
                  <span>booked by {featured.client.business} off $647 in ad spend, two weeks after launch <Icon name="arrow" size={16} /></span>
                </a>
              )}
              <ul class="svc__pts">{s.points.map((p) => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="section dark process" id="process" aria-labelledby="process-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow" data-reveal>How it works</p>
          <h2 id="process-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">We handle it</span></span><span class="l"><span class="l__in grad">start to finish.</span></span></h2>
          <p class="muted head__p" data-reveal>Your only job is to show up for the shoot. We do the rest.</p>
        </div>
        <ol class="steps" data-stagger>
          {steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__n display">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="results" aria-labelledby="results-h">
      <div class="wrap">
        <h2 id="results-h" class="sr-only">Results</h2>
        <ul class="stats" data-stagger>
          {stats.map((s) => (
            <li class="stat" data-reveal>
              <p class="stat__v display">
                {s.sample ? "—" : <>{s.prefix}<span data-count={s.value}>{s.value.toLocaleString("en-US")}</span>{s.suffix}</>}
              </p>
              <p class="stat__l">{s.label}</p>
              {s.sample && <span class="tag">Sample</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- WORK -->
    <section class="section" id="work" aria-labelledby="work-h">
      <div class="wrap">
        <div class="head head--row">
          <div>
            <p class="eyebrow" data-reveal>Our work</p>
            <h2 id="work-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">Made for real</span></span><span class="l"><span class="l__in grad">businesses.</span></span></h2>
          </div>
          <p class="muted head__p" data-reveal>Every project below was planned, shot, built and run by our team.</p>
        </div>
        <ul class="work" data-stagger>
          {work.map((w, i) => (
            <li class:list={["work__card", i === 0 && "work__card--wide"]} data-reveal>
              <VideoFrame playbackId={w.playbackId} title={`${w.client}: ${w.title}`} posterTime={w.posterTime} label="Watch" ratio={i === 0 ? "16 / 9" : "4 / 5"} sizes={i === 0 ? "(min-width: 1280px) 1240px, 100vw" : "(min-width: 900px) 600px, 100vw"} />
              <div class="work__meta">
                <div>
                  <p class="work__client">{w.client} {isSample(w) && <span class="tag">Sample</span>}</p>
                  <p class="muted work__ind">{w.industry}</p>
                </div>
                <ul class="chips">{w.services.map((s) => <li>{s}</li>)}</ul>
              </div>
              <h3 class="work__title">{w.title}</h3>
              {w.result && <p class="work__result">{w.result}</p>}
              {w.url && <a class="work__link" href={w.url} target="_blank" rel="noopener">Visit the site <Icon name="arrow" size={16} /></a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CONCERNS -->
    <section class="section stories" aria-labelledby="stories-h">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow" data-reveal>Before they signed</p>
          <h2 id="stories-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">They had doubts</span></span><span class="l"><span class="l__in grad">too.</span></span></h2>
          <p class="muted head__p" data-reveal>Here's what worried our clients before they signed, and what happened next.</p>
        </div>
        <ul class="story-list" data-stagger>
          {stories.map((s) => (
            <li class:list={["story", s.video && "story--video"]} data-reveal>
              {s.video && (
                <div class="story__video">
                  <VideoFrame playbackId={s.video.playbackId} title={`${s.name || "Client"} on working with ${site.name}`} posterTime={s.video.posterTime} ratio={s.video.ratio ?? "9 / 16"} label="Watch" sizes="(min-width: 760px) 300px, 100vw" />
                  {s.when && <span class="story__when">{s.when}</span>}
                </div>
              )}
              {isSample(s) && <span class="tag story__tag">Sample</span>}
              <p class="story__label">The concern</p>
              <p class="story__concern display">{s.concern}</p>
              {s.concernQuote && <p class="story__concern-quote">“{s.concernQuote}”<span class="muted">{s.name || "Our client"}</span></p>}
              <p class="story__label story__label--ok">What happened</p>
              <p class="story__outcome">{s.outcome}</p>
              {(s.quote || s.name) && (
                <blockquote class="story__quote">
                  {s.quote && <p>“{s.quote}”</p>}
                  {s.name && <footer><strong>{s.name}</strong>{s.business && <span class="muted">{s.business}</span>}</footer>}
                </blockquote>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <div class="head faq__head">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 id="faq-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">Straight</span></span><span class="l"><span class="l__in grad">answers.</span></span></h2>
          <p class="muted head__p" data-reveal>Something not covered here? Ask us on the call. That's what it's for.</p>
        </div>
        <div class="faq__list" data-stagger>
          {faqs.map((f, i) => (
            <details class="qa" data-reveal open={i === 0}>
              <summary><span>{f.q}</span><span class="qa__icon" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
              <div class="qa__a"><p class="muted">{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta dark" id="book" aria-labelledby="cta-h">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="wrap cta__in">
        <h2 id="cta-h" class="display cta__title" data-reveal="lines"><span class="l"><span class="l__in">Ready to get</span></span><span class="l"><span class="l__in grad">amplified?</span></span></h2>
        <p class="muted cta__p" data-reveal>Answer a few quick questions about your business. It takes about 60 seconds, and if we're a fit, we'll reach out to you personally.</p>
        <div class="cta__ctas" data-reveal>
          <a class="btn" href={site.ctaUrl}>{hero.primaryCta} <Icon name="arrow" size={18} /></a>
          {site.phone.tel ? <a class="btn btn--ghost" href={`tel:${site.phone.tel}`}>{site.phone.display}</a> : <a class="btn btn--ghost" href={`mailto:${site.email}`}>{site.email}</a>}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot dark">
    <div class="wrap foot__in">
      <Logo class="foot__logo" height={44} />
      <p class="muted">© {new Date().getFullYear()} {site.name}</p>
      <a class="muted" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </footer>
</Base>

<style>
  .grad { background: linear-gradient(90deg, var(--brand-hi), #a98bff 60%, #fff); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.08em; }
  :not(.dark) > .wrap .grad, .section:not(.dark) .grad { background-image: linear-gradient(90deg, var(--brand), var(--brand-hi)); }

  /* Hero */
  .hero { position: relative; padding-top: clamp(8rem, 18vw, 12rem); padding-bottom: clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .hero__glow { position: absolute; inset: 0; pointer-events: none; }
  .hero__glow span { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.75; animation: drift 18s ease-in-out infinite alternate; }
  .hero__glow span:first-child { width: 60vw; height: 60vw; max-width: 820px; max-height: 820px; left: -18vw; top: max(6vw, 90px); background: radial-gradient(closest-side, var(--brand), transparent); }
  .hero__glow span:last-child { width: 45vw; height: 45vw; max-width: 620px; max-height: 620px; right: -12vw; top: 10%; background: radial-gradient(closest-side, #7a2bff, transparent); animation-duration: 22s; animation-delay: -6s; }
  @keyframes drift { to { transform: translate3d(8vw, 6vw, 0) scale(1.15); } }
  .hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--line-dark) 1px, transparent 1px), linear-gradient(90deg, var(--line-dark) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 20%, transparent 75%); opacity: 0.5; }
  .hero__in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "video" "caption" "cta" "proof";
    align-items: start;
  }
  .hero__title { grid-area: title; font-size: clamp(2.1rem, 4.4vw, 4rem); }
  .hero__video { grid-area: video; margin-top: 1.75rem; }
  .hero__video :global(.vf) { box-shadow: 0 40px 120px -30px rgb(59 0 252 / 0.65), 0 0 0 1px var(--line-dark); }
  .hero__caption { grid-area: caption; margin-top: 1rem; font-size: 1.05rem; font-weight: 600; }
  .hero__cta { grid-area: cta; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; margin-top: 1.5rem; }
  .hero__btn { padding: 1.1rem 1.75rem; font-size: 1.05rem; }
  .hero__note { font-size: 0.92rem; }
  .hero__proof {
    grid-area: proof; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(2.5rem, 6vw, 4rem); padding-top: 1.75rem; border-top: 1px solid var(--line-dark); text-decoration: none;
  }
  .hero__stat { display: flex; align-items: baseline; gap: 0.55rem; }
  .hero__stat strong { font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1; color: #fff; }
  .hero__stat:first-child strong { color: var(--brand-hi); }
  .hero__stat span { color: var(--muted-dark); font-size: 0.95rem; }
  .hero__who { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted-dark); font-size: 0.9rem; transition: color 0.3s; }
  .hero__proof:hover .hero__who { color: #fff; }
  .hero__who :global(svg) { transform: rotate(90deg); }
  @media (max-width: 899px) {
    .hero { padding-top: 6.5rem; }
    .hero__who { margin-left: 0; width: 100%; }
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto 1fr auto;
      grid-template-areas: ". video" "title video" "caption video" "cta video" ". video" "proof proof";
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .hero__video { margin-top: 0; align-self: center; }
    .hero__title { font-size: clamp(2.3rem, 3.55vw, 3.35rem); }
    .hero__title .l__in { text-wrap: balance; }
    .hero__cta { margin-top: 2rem; }
    .hero__caption { margin-top: 1.5rem; }
  }

  /* Ticker */
  .ticker { overflow: hidden; background: var(--brand); color: #fff; padding-block: 1.1rem; }
  .ticker__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .ticker span { display: inline-flex; align-items: center; gap: 2rem; padding-right: 2rem; font-size: clamp(1.1rem, 2.2vw, 1.6rem); white-space: nowrap; }
  .ticker i { font-style: normal; font-size: 0.7em; opacity: 0.6; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* Section heads */
  .head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .head--row { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; }
  .head--row .head__p { max-width: 24rem; }
  .h2 { font-size: clamp(2.1rem, 6vw, 4.6rem); margin-top: 1.1rem; }
  .head__p { margin-top: 1.4rem; font-size: 1.125rem; }

  /* Services */
  .svc-sec { padding-top: 0; }
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 1rem; }
  @media (max-width: 860px) { .svc { grid-template-columns: 1fr; } }
  .svc__card.svc__card--main { grid-row: span 2; display: flex; flex-direction: column; padding: clamp(2rem, 4vw, 3rem); background: var(--ink); color: #fff; border-color: transparent; }
  .svc__card.svc__card--main::before { opacity: 1; background: radial-gradient(90% 70% at 100% 0%, rgb(59 0 252 / 0.55), transparent 65%), radial-gradient(70% 60% at 0% 100%, rgb(122 43 255 / 0.3), transparent 60%); }
  .svc__card.svc__card--main:hover { border-color: transparent; }
  .svc__card.svc__card--main h3 { font-family: var(--font-display); font-weight: 850; font-stretch: 125%; font-style: italic; text-transform: uppercase; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 0.95; }
  .svc__card.svc__card--main p { color: var(--muted-dark); font-size: 1.125rem; max-width: 30rem; }
  .svc__card.svc__card--main .svc__pts { margin-top: auto; padding-top: 2rem; font-size: 1.02rem; gap: 0.7rem; }
  .svc__card.svc__card--main .svc__pts li::before { background: var(--brand-hi); }
  .svc__proof { display: flex; align-items: center; gap: 1.25rem; margin-top: 2.5rem; padding: 1.25rem 1.5rem; border-radius: var(--radius); background: rgb(255 255 255 / 0.06); border: 1px solid var(--line-dark); text-decoration: none; color: #fff; transition: background 0.3s; }
  .svc__proof:hover { background: rgb(255 255 255 / 0.1); }
  .svc__proof-n { font-size: clamp(2rem, 4vw, 2.8rem); color: var(--brand-hi); line-height: 1; flex: none; }
  .svc__proof span:last-child { font-size: 0.98rem; color: var(--muted-dark); }
  .svc__proof svg { display: inline; vertical-align: -3px; }
  .svc__badge { padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--brand); color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .svc__card { position: relative; padding: 2rem 1.75rem; border-radius: var(--radius-lg); background: var(--paper-2); border: 1px solid var(--line); overflow: hidden; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.5s; }
  .svc__card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 80% at 0% 0%, var(--brand-soft), transparent 60%); opacity: 0; transition: opacity 0.5s; z-index: 0; }
  .svc__card > * { position: relative; }
  .svc__card:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgb(59 0 252 / 0.4); border-color: rgb(59 0 252 / 0.3); }
  .svc__card:hover::before { opacity: 1; }
  .svc__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
  .svc__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--brand); color: #fff; transition: transform 0.5s var(--ease); }
  .svc__card:hover .svc__icon { transform: rotate(-8deg) scale(1.06); }
  .svc__n { font-family: var(--font-display); font-weight: 700; color: var(--muted); font-size: 0.9rem; }
  .svc h3 { font-size: 1.4rem; font-weight: 750; letter-spacing: -0.01em; line-height: 1.15; }
  .svc p { margin-top: 0.75rem; }
  .svc__pts { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.5rem; font-size: 0.95rem; }
  .svc__pts li { display: flex; gap: 0.6rem; align-items: baseline; }
  .svc__pts li::before { content: ""; flex: none; width: 6px; height: 6px; border-radius: 2px; background: var(--brand); transform: translateY(-2px) rotate(45deg); }

  /* Process */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; counter-reset: s; }
  .step { position: relative; padding: 2rem 1.75rem 2rem 0; border-top: 1px solid var(--line-dark); }
  .step::before { content: ""; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--brand-hi); transition: width 1.2s var(--ease) calc(var(--i, 0) * 200ms + 300ms); }
  .step.is-in::before { width: 100%; }
  .step__n { display: block; font-size: clamp(2.6rem, 5vw, 3.6rem); color: transparent; -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.35); margin-bottom: 1.5rem; }
  .step h3 { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.01em; }
  .step p { margin-top: 0.7rem; }

  /* Results */
  .results { background: var(--brand); color: #fff; padding-block: clamp(3.5rem, 8vw, 5.5rem); position: relative; overflow: hidden; }
  .results::before { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 120% at 100% 0%, rgb(255 255 255 / 0.18), transparent 60%); }
  .stats { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; }
  .stat__v { font-size: clamp(2.8rem, 6vw, 4.4rem); line-height: 1; }
  .stat__l { margin-top: 0.6rem; color: rgb(255 255 255 / 0.8); max-width: 16rem; }
  .stat .tag { margin-top: 0.8rem; }

  /* Work */
  .work { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem); }
  .work__card--wide { grid-column: 1 / -1; }
  .work__meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-top: 1.25rem; }
  .work__client { font-weight: 700; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .work__ind { font-size: 0.92rem; }
  .chips { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; list-style: none; margin: 0; padding: 0; }
  .chips li { font-size: 0.78rem; font-weight: 600; padding: 0.3rem 0.7rem; border-radius: 999px; border: 1px solid var(--line); }
  .work__title { font-family: var(--font-body); font-size: clamp(1.3rem, 2.4vw, 1.75rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-top: 0.75rem; }

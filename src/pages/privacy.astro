---
/**
 * Privacy policy. A plain-English starting point, not legal advice:
 * have it reviewed, and fill in the legal name, state and mailing address.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { pageGraph } from "../lib/schema";

const updated = "October 28, 2026";
const title = `Privacy policy | ${site.name}`;
const description = `How ${site.name} collects, uses and protects the information you share with us.`;
---

<Base title={title} description={description} schema={pageGraph("/privacy/", title, description)}>
  <div class="lg dark">
    <header class="wrap lg__top"><a href="/" aria-label={`${site.name} home`}><Logo height={38} eager /></a></header>
    <main id="main" class="wrap lg__main">
      <h1 class="display">Privacy policy</h1>
      <p class="muted">Last updated {updated}</p>

      <p>{site.name} ("we", "us") runs this website. This policy explains what information we collect when you visit it or fill out our quiz, how we use it, and the choices you have.</p>

      <h2>What we collect</h2>
      <ul>
        <li><strong>Information you give us.</strong> When you take our quiz, we collect your answers (such as your type of business, timeline, revenue range and ad budget) and your contact details: name, business name, phone number, email and city.</li>
        <li><strong>Information collected automatically.</strong> Like most websites, our hosting provider records basic technical data such as your IP address, browser and the pages you visit. If we use the Meta Pixel, Meta may collect information about your visit through cookies to measure and improve our ads.</li>
      </ul>

      <h2>How we use it</h2>
      <ul>
        <li>To review your answers and contact you about your inquiry by phone, text or email.</li>
        <li>To provide and improve our services and this website.</li>
        <li>To measure how our advertising performs.</li>
      </ul>
      <p>We don't sell your personal information.</p>

      <h2>Who we share it with</h2>
      <p>We share information only with service providers that help us run our business, such as our website host and form provider (Netlify), our customer relationship tools, and advertising platforms like Meta for measuring ads. They may use it only to provide their services to us. We may also share information if the law requires it.</p>

      <h2>Calls and text messages</h2>
      <p>If you give us your phone number and agree to be contacted, we may call or text you about your inquiry. Message and data rates may apply. You can reply STOP to any text to opt out, or ask us to stop calling at any time.</p>

      <h2>Cookies and ad tracking</h2>
      <p>You can block or delete cookies in your browser settings. You can control how Meta uses your information for ads in your Facebook or Instagram ad preferences.</p>

      <h2>Your choices and rights</h2>
      <p>You can ask us to access, correct or delete the personal information we hold about you, or to stop contacting you. Depending on where you live (for example, California), you may have additional rights under local law. To make a request, email us at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>

      <h2>How long we keep it</h2>
      <p>We keep your information only as long as we need it for the purposes above or as the law requires.</p>

      <h2>Children</h2>
      <p>This website is meant for business owners and isn't directed at children under 13. We don't knowingly collect their information.</p>

      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. The date at the top shows when it last changed.</p>

      <h2>Contact us</h2>
      <p>Questions about this policy? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .lg__top { display: flex; align-items: center; height: 84px; }
  .lg__main { max-width: 760px; padding-block: 2rem 5rem; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-bottom: 0.75rem; }
  h2 { font-family: var(--font-body); font-size: 1.3rem; font-weight: 750; letter-spacing: -0.01em; margin-top: 2.5rem; }
  p, ul { margin-top: 0.9rem; color: rgb(255 255 255 / 0.85); }
  ul { padding-left: 1.2rem; display: grid; gap: 0.6rem; }
  a { color: var(--brand-hi); }
  @media (max-width: 899px) { .lg__top { justify-content: center; } }
</style>

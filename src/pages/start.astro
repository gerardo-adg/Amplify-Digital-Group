---
/**
 * Ads landing page (/start/). One job: get qualified contractors through
 * the quiz, which sits right in the hero. Everything below it answers
 * objections and shows proof, and every button jumps back up to the quiz.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import VideoFrame from "../components/VideoFrame.astro";
import QuizForm from "../components/QuizForm.astro";
import Footer from "../components/Footer.astro";
import { site, hero, objections, proofCards, faqs } from "../data/site";

// The VSL shows above the quiz once hero.vsl.playbackId is set
const hasVsl = Boolean(hero.vsl.playbackId);
const quizLink = "#quiz";
const title = `Meta ads for contractors: we'll bring the jobs to you | ${site.name}`;
---

<Base title={title} description={site.description}>
  <Header ctaHref={quizLink} />
  <main id="main">
    <!-- HERO: the promise, then the quiz -->
    <section class="hero dark" id="top">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="wrap hero__in">
        <h1 class="display hero__title" data-reveal="lines">
          <span class="hero__callout">{hero.callout}</span>{" "}
          {hero.title.map((line, i) => <span class:list={["l", i > 0 && "l--promise"]}><span class:list={["l__in", i > 0 && "grad hero__promise"]}>{line}</span>{" "}</span>)}
        </h1>
        <p class="hero__sub muted">{hero.subheadline}</p>
        {hasVsl && (
          <div class="hero__video">
            <VideoFrame playbackId={hero.vsl.playbackId} title={hero.vsl.title} posterTime={hero.vsl.posterTime} label="Watch the video" sizes="(min-width: 900px) 820px, 100vw" />
          </div>
        )}
        {hasVsl && <p class="hero__caption">{hero.vsl.caption}</p>}
        <p class="hero__note muted">{hero.ctaNote}</p>
        <div class="hero__quiz">
          <QuizForm card />
        </div>
      </div>
    </section>

    <!-- OBJECTIONS: the three biggest, most common first -->
    <section class="obj" aria-label="Common concerns">
      <ul class="wrap obj__list" data-stagger>
        {objections.map((o) => (
          <li class="obj__item" data-reveal>
            <span class="obj__check" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
            <div>
              <p class="obj__q">{o.q}</p>
              <p class="obj__a muted">{o.a}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- PROOF -->
    <section class="section proof" id="proof" aria-labelledby="proof-h">
      <div class="wrap">
        <div class="head head--center">
          <p class="eyebrow" data-reveal>Proof over promises</p>
          <h2 id="proof-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">Real contractors.</span></span><span class="l"><span class="l__in grad">Real results.</span></span></h2>
        </div>
        <ul class="proof__list" data-stagger>
          {proofCards.map((c) => (
            <li class="pc" data-reveal>
              <VideoFrame playbackId={c.video.playbackId} title={c.video.title} posterTime={c.video.posterTime} ratio="4 / 5" label={c.video.label} sizes="(min-width: 760px) 470px, 100vw" />
              <div class="pc__body">
                <p class="pc__result">{c.result}</p>
                <p class="pc__detail muted">{c.detail}</p>
                <blockquote class="pc__quote">
                  <p>“{c.quote}”</p>
                  <footer><strong>{c.name}</strong><span class="muted">{c.business}</span></footer>
                </blockquote>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <div class="head faq__head">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 id="faq-h" class="display h2" data-reveal="lines"><span class="l"><span class="l__in">Straight</span></span><span class="l"><span class="l__in grad">answers.</span></span></h2>
        </div>
        <div class="faq__list" data-stagger>
          {faqs.map((f, i) => (
            <details class="qa" data-reveal open={i === 0}>
              <summary><span>{f.q}</span><span class="qa__icon" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
              <div class="qa__a"><p class="muted">{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta dark" id="book" data-sticky-stop aria-labelledby="cta-h">
      <div class="hero__glow" aria-hidden="true"><span></span><span></span></div>
      <div class="wrap cta__in">
        <h2 id="cta-h" class="display cta__title" data-reveal="lines"><span class="l"><span class="l__in">Ready to get</span></span><span class="l"><span class="l__in grad">amplified?</span></span></h2>
        <p class="muted cta__p" data-reveal>{hero.ctaNote}</p>
        <div class="cta__ctas" data-reveal>
          <a class="btn" href={quizLink}>{hero.primaryCta} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </section>
  </main>

  <!-- Phones: the one action stays in reach once the quiz scrolls away -->
  <div class="sticky-cta" data-sticky aria-hidden="true">
    <a class="btn sticky-cta__btn" href={quizLink} tabindex="-1">{hero.primaryCta} <Icon name="arrow" size={18} /></a>
  </div>

  <Footer />
</Base>

<style>
  .grad { background: linear-gradient(90deg, var(--brand-hi), #a98bff 60%, #fff); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.08em; }
  :not(.dark) > .wrap .grad, .section:not(.dark) .grad { background-image: linear-gradient(90deg, var(--brand), var(--brand-hi)); }

  /* Hero: headline, then the quiz right there */
  .hero { position: relative; padding-top: clamp(7.5rem, 12vw, 9.5rem); padding-bottom: clamp(3rem, 7vw, 5rem); overflow: hidden; text-align: center; }
  .hero__glow { position: absolute; inset: 0; pointer-events: none; }
  .hero__glow span { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.75; animation: drift 18s ease-in-out infinite alternate; }
  .hero__glow span:first-child { width: 60vw; height: 60vw; max-width: 820px; max-height: 820px; left: -18vw; top: max(6vw, 90px); background: radial-gradient(closest-side, var(--brand), transparent); }
  .hero__glow span:last-child { width: 45vw; height: 45vw; max-width: 620px; max-height: 620px; right: -12vw; top: 10%; background: radial-gradient(closest-side, #7a2bff, transparent); animation-duration: 22s; animation-delay: -6s; }
  @keyframes drift { to { transform: translate3d(8vw, 6vw, 0) scale(1.15); } }
  .hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--line-dark) 1px, transparent 1px), linear-gradient(90deg, var(--line-dark) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 20%, transparent 75%); opacity: 0.5; }
  .hero__in { position: relative; display: flex; flex-direction: column; align-items: center; }
  .hero__title { font-size: clamp(2.2rem, 3.6vw, 3.4rem); }
  .hero__title .l { white-space: nowrap; }
  /* Callout: highlighted, like a marker swipe behind the words */
  .hero__callout {
    display: table; margin: 0 auto 1.1rem; padding: 0 0.3em;
    font-family: var(--font-body); font-style: normal; font-weight: 800; font-stretch: normal;
    text-transform: none; letter-spacing: -0.01em; font-size: clamp(1.05rem, 2vw, 1.45rem); color: #fff;
    background: linear-gradient(transparent 52%, var(--brand) 52%, var(--brand) 92%, transparent 92%);
  }
  /* The promise line is underlined in brand blue */
  .hero__title .l--promise { padding-bottom: 0.18em; }
  .hero__promise { text-decoration: underline; text-decoration-color: var(--brand-hi); text-decoration-thickness: 0.07em; text-underline-offset: 0.14em; text-decoration-skip-ink: none; }
  .hero__sub { margin-top: 1.1rem; max-width: 38rem; font-size: clamp(1.05rem, 1.5vw, 1.2rem); }
  .hero__video { width: 100%; max-width: 820px; margin-top: 2rem; }
  .hero__video :global(.vf) { box-shadow: 0 40px 120px -30px rgb(59 0 252 / 0.65), 0 0 0 1px var(--line-dark); }
  .hero__caption { margin-top: 1rem; font-size: 1.05rem; font-weight: 600; }
  @media (max-width: 899px) {
    .hero { padding-top: 5.5rem; }
    .hero__title { font-size: clamp(1.75rem, 8.4vw, 2.6rem); text-wrap: balance; }
    .hero__title .l, .hero__title .l__in { display: inline; white-space: normal; }
    .hero__sub { margin-top: 0.75rem; font-size: 1rem; }
    .hero__callout { margin-bottom: 0.7rem; font-size: 1rem; }
    .hero__note { margin-top: 0.6rem; }
    .hero__quiz { margin-top: 1.25rem; }
  }

  /* Section heads */
  .head { max-width: 46rem; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .head--center { margin-inline: auto; text-align: center; }
  .head--row { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; }
  .head--row .head__p { max-width: 24rem; }
  .h2 { font-size: clamp(2.1rem, 6vw, 4.6rem); margin-top: 1.1rem; }
  .head__p { margin-top: 1.4rem; font-size: 1.125rem; }

  /* Quiz in the hero */
  .hero__note { margin-top: 0.9rem; font-size: 0.92rem; }
  .hero__quiz { width: 100%; margin-top: clamp(1.5rem, 4vw, 2.25rem); }

  /* Objections */
  .obj { background: var(--paper); border-bottom: 1px solid var(--line); }
  .obj__list { list-style: none; margin-block: 0; padding: clamp(2.5rem, 5vw, 3.5rem) 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .obj__item { display: flex; gap: 0.9rem; align-items: flex-start; }
  .obj__check { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand); color: #fff; margin-top: 0.1rem; }
  .obj__q { font-weight: 750; font-size: 1.08rem; letter-spacing: -0.01em; }
  .obj__a { margin-top: 0.35rem; font-size: 0.98rem; }
  @media (max-width: 899px) { .obj__list { grid-template-columns: 1fr; } }

  /* Proof cards */
  .proof { background: var(--paper-2); }
  .proof .h2 { font-size: clamp(2rem, 4.6vw, 3.6rem); }
  .proof__list { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2rem); max-width: 980px; }
  .pc { display: flex; flex-direction: column; padding: 0.75rem 0.75rem 1.75rem; border-radius: var(--radius-lg); background: var(--paper); border: 1px solid var(--line); box-shadow: 0 30px 60px -40px rgb(7 5 26 / 0.35); }
  .pc__body { padding: 1.5rem 1rem 0; }
  .pc__result { font-family: var(--font-display); font-weight: 850; font-stretch: 125%; font-style: italic; text-transform: uppercase; font-size: clamp(1.35rem, 2.4vw, 1.75rem); line-height: 1.05; color: var(--brand); }
  .pc__detail { margin-top: 0.6rem; }
  .pc__quote { margin: 1.25rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .pc__quote p { font-style: italic; font-size: 1.08rem; }
  .pc__quote footer { display: flex; flex-direction: column; margin-top: 0.6rem; font-size: 0.92rem; }
  @media (max-width: 760px) { .proof__list { grid-template-columns: 1fr; max-width: 440px; } }
  @media (max-width: 899px) { .pc__quote footer { align-items: center; } }

  /* FAQ */
  .faq__in { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq__head { position: sticky; top: 110px; margin-bottom: 0; }
  .faq__head .h2 { font-size: clamp(2.1rem, 4.6vw, 3.9rem); }
  @media (max-width: 860px) { .faq__in { grid-template-columns: 1fr; } .faq__head { position: static; } }
  .qa { border-bottom: 1px solid var(--line); }
  .qa:first-child { border-top: 1px solid var(--line); }
  .qa summary { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.5rem 0; cursor: pointer; list-style: none; font-size: clamp(1.05rem, 1.8vw, 1.25rem); font-weight: 650; letter-spacing: -0.01em; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa__icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: var(--paper-2); color: var(--brand); transition: transform 0.5s var(--ease), background 0.3s, color 0.3s; }
  .qa summary:hover .qa__icon { background: var(--brand-soft); }
  .qa[open] .qa__icon { transform: rotate(45deg); background: var(--brand); color: #fff; }
  .qa__a { padding: 0 3.5rem 1.6rem 0; }
  .qa[open] .qa__a { animation: open 0.6s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-8px); } }

  /* CTA */
  .cta { position: relative; overflow: hidden; padding-block: clamp(6rem, 14vw, 11rem); text-align: center; }
  .cta__in { position: relative; }
  .cta__title { font-size: clamp(2.6rem, 9vw, 7.5rem); }
  .cta__p { max-width: 34rem; margin: 1.75rem auto 0; font-size: 1.15rem; }
  .cta__ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; justify-content: center; }

  /* ---- Phones and small tablets: everything centered ---- */
  @media (max-width: 899px) {
    main { text-align: center; }
    .head, .head__p { margin-inline: auto; }
    .head--row { flex-direction: column; align-items: center; }
    .obj__item { flex-direction: column; align-items: center; text-align: center; }
    .story--video { text-align: center; }
    .story__outcome { margin-inline: auto; }
    .story__quote footer { align-items: center; }
    .qa summary { text-align: center; }
    .qa summary > span:first-child { flex: 1; }
    .qa summary::before { content: ""; flex: none; width: 40px; }
    .qa__a { padding: 0 0 1.6rem; }
  }

  /* Sticky button bar (phones only) */
  .sticky-cta { display: none; }
  @media (max-width: 899px) {
    .sticky-cta {
      display: block; position: fixed; inset: auto 0 0; z-index: 40;
      padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
      background: rgb(7 5 26 / 0.85); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 -1px 0 var(--line-dark);
      transform: translateY(110%); transition: transform 0.45s var(--ease);
    }
    .sticky-cta.is-on { transform: none; }
    .sticky-cta__btn { width: 100%; justify-content: center; }

    /* Process: compact on phones, number beside the title */
  }
</style>

<script>
  // Show the bar once the quiz is scrolled past; hide it at the closing call to action and footer
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  const quiz = document.querySelector("[data-quiz-root]");
  const stops = document.querySelectorAll("[data-sticky-stop], footer");
  if (bar && quiz && "IntersectionObserver" in window) {
    let pastQuiz = false;
    const visibleStops = new Set<Element>();
    const update = () => {
      const on = pastQuiz && visibleStops.size === 0;
      bar.classList.toggle("is-on", on);
      bar.setAttribute("aria-hidden", String(!on));
      bar.querySelector("a")?.setAttribute("tabindex", on ? "0" : "-1");
    };
    new IntersectionObserver(([e]) => {
      pastQuiz = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }).observe(quiz);
    const stopObserver = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visibleStops.add(e.target) : visibleStops.delete(e.target)));
      update();
    });
    stops.forEach((el) => stopObserver.observe(el));
  }
</script>

---
/**
 * Standalone quiz page, for links straight to the quiz. The same quiz
 * sits in the landing page hero (src/components/QuizForm.astro).
 */
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import Footer from "../../components/Footer.astro";
import QuizForm from "../../components/QuizForm.astro";
import { site } from "../../data/site";
import { quiz } from "../../data/quiz";
import { pageGraph } from "../../lib/schema";

const title = `${quiz.title} | ${site.name}`;
---

<Base title={title} description={quiz.intro} schema={pageGraph("/quiz/", title, quiz.intro)}>
  <div class="qp dark">
    <div class="qp__glow" aria-hidden="true"><span></span><span></span></div>
    <header class="qp__top wrap">
      <a href="/" aria-label={`${site.name} home`}><Logo height={36} eager /></a>
    </header>
    <main id="main" class="qp__main wrap">
      <QuizForm intro />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .qp { position: relative; min-height: 100vh; min-height: 100dvh; overflow: hidden; display: flex; flex-direction: column; }
  .qp__glow { position: absolute; inset: 0; pointer-events: none; }
  .qp__glow span { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.6; animation: drift 20s ease-in-out infinite alternate; }
  .qp__glow span:first-child { width: 55vw; height: 55vw; max-width: 760px; max-height: 760px; left: -20vw; bottom: -20vw; background: radial-gradient(closest-side, var(--brand), transparent); }
  .qp__glow span:last-child { width: 40vw; height: 40vw; max-width: 560px; max-height: 560px; right: -10vw; top: 15%; background: radial-gradient(closest-side, #7a2bff, transparent); animation-delay: -7s; }
  @keyframes drift { to { transform: translate3d(6vw, -5vw, 0) scale(1.1); } }
  .qp__top { position: relative; display: flex; align-items: center; height: 84px; }
  .qp__main { position: relative; flex: 1; width: min(100% - 2 * var(--gutter), 720px); padding-block: clamp(1.5rem, 5vh, 4rem) 4rem; }
  @media (max-width: 899px) { .qp__top { justify-content: center; } }
</style>
